# Google AI Studio key (free tier works): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional. Chat model, defaults to gemini-2.5-flash.
GEMINI_MODEL=gemini-2.5-flash
# Optional. Comma-separated models to try when the main one is overloaded (503) or rate limited (429).
GEMINI_FALLBACK_MODEL=gemini-flash-latest

# Supabase project (Settings -> API). Service role key stays server-side only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
